{
  "name": "sdd-tdd-framework",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run api:dev\" \"npm run ui\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ui": "cd sdd-frontend && npm run dev",
    "api:dev": "tsx watch --exclude workspaces/**/* --exclude users.json src/infrastructure/api/server.ts",
    "users:migrate": "tsx scripts/migrate-users.ts",
    "spec:check": "tsx scripts/spec-check.ts"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.4",
    "concurrently": "^9.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.3.6"
  }
}
