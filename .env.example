# ============================================================================
# SDD-TDD Framework — Environment Template
# Copia este archivo a `.env` y rellena los valores antes de arrancar el server.
# `.env` está en .gitignore y NUNCA debe commitearse.
# ============================================================================

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Secreto para firmar JWT y tickets de descarga.
# OBLIGATORIO en producción. Mínimo 32 caracteres.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Puerto del API Express
PORT=3000

# Directorio raíz donde se persisten los proyectos SDD
# (por defecto: ./workspaces)
# WORKSPACES_DIR=

# Costo de bcrypt para hashing de contraseñas (rango razonable: 10-14)
BCRYPT_COST=12

# ----------------------------------------------------------------------------
# Llaves de proveedores de IA (opcionales)
# Si se definen aquí, el frontend mostrará un indicador "server-side key" y
# no será necesario que el usuario las introduzca manualmente.
# ----------------------------------------------------------------------------
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
